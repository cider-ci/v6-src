# Cider-CI Executor — environment configuration
# Managed by Ansible. Do not edit by hand.

CIDER_CI_SERVER_URL={{ ci_executor_server_url }}
CIDER_CI_EXECUTOR_TOKEN={{ ci_executor_token }}
CIDER_CI_EXECUTOR_MAX_LOAD={{ ci_executor_max_load }}

# Trial scripts run in a non-login bash (ProcessBuilder ["bash", <script>]),
# which never sources /etc/profile.d. BASH_ENV makes that non-interactive bash
# source the executor's trait environment (tool-manager activation, DB env
# vars) so trial scripts get what the traits promise (e.g. bundle/ruby on PATH,
# PG15PORT/PG15USER). The JVM inherits this and passes it to script subprocesses.
BASH_ENV=/etc/cider-ci/trial-bash-env.sh
