#!/bin/bash
# {{ ansible_managed }}

PORT={{ ci_executor_trait_postgresql_port }}

until pg_isready -p "$PORT" -q; do sleep 1; done

psql -p "$PORT" -U postgres -c \
  "CREATE ROLE root SUPERUSER CREATEDB LOGIN;" \
  2>/dev/null || true

psql -p "$PORT" -U postgres -c \
  "CREATE DATABASE root OWNER root;" \
  2>/dev/null || true

psql -p "$PORT" -U postgres -c \
  "CREATE ROLE \"{{ ci_executor_trait_postgresql_exec_user }}\" SUPERUSER CREATEDB LOGIN PASSWORD '{{ ci_executor_trait_postgresql_exec_user_password }}';" \
  2>/dev/null || true

psql -p "$PORT" -U postgres -c \
  "CREATE DATABASE \"{{ ci_executor_trait_postgresql_exec_user }}\" OWNER \"{{ ci_executor_trait_postgresql_exec_user }}\";" \
  2>/dev/null || true

psql -p "$PORT" -U postgres -c \
  "CREATE ROLE \"cider-ci\" SUPERUSER CREATEDB LOGIN PASSWORD 'cider-ci';" \
  2>/dev/null || true

# Provide uuidv7() for PostgreSQL < 17 (PG17+ has it built in).
# Creating it in template1 makes it available in every new database.
psql -p "$PORT" -U postgres -d template1 -c "
CREATE OR REPLACE FUNCTION uuidv7() RETURNS uuid LANGUAGE sql AS \$\$
  SELECT (
    lpad(to_hex(floor(extract(epoch from clock_timestamp())*1000)::bigint), 12, '0') ||
    '7' ||
    lpad(to_hex(floor(random()*4096)::int), 3, '0') ||
    lpad(to_hex(floor(random()*16384 + 32768)::int), 4, '0') ||
    lpad(to_hex(floor(random()*281474976710656)::bigint), 12, '0')
  )::uuid
\$\$;" 2>/dev/null || true
